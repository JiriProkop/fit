                    {
                        if(GRAPH == "")
                        {
                            printf("%s: %d\n", prev_cntr, c)
                        }
                        else
                        {
                            printf("%s: ", prev_cntr)
                            for(i = 0; i < c / WIDTH - 1; i++)
                            {
                                printf("#")
