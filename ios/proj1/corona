                    printf("76-85 : %d\n86-95 : %d\n96-105: %d\n>105  : %d\n", c[8], c[9], c[10], c[11])
                    if(none != 0) printf("None: %d\n", none)
                }
                else
                {
                    if(WIDTH == "")
                    {
                        rate = 10000
                    }
                    else
                    {
                        max = c[0]
