export POSIXLY_CORRECT=yes
export LC_ALL=C

print_help()
{
    echo "Usage: corona [-h] [FILTERS] [COMMAND] [LOG [LOG2 [...]]"
    echo "                                                     "
    echo "If there's no log file as an argument, you can write log"
    echo "into terminal. Press 'ctrl + d' to end the input."
    echo "                                                    "
    echo "Commands:"
    echo "  infected    -sum of infected people"
    echo "  merge       -merge several logs into one, keeps original order"
    echo "  gender      -infected listed by gender"
    echo "  age         -infected listed by age intervals"
    echo "  daily       -infected listed by days"
    echo "  monthly     -infected listed by months"
    echo "  yearly      -infected listed by years"
    echo "  countries   -infected listed by countries"
    echo "  districts   -infected listed by districts"
    echo "  regions     -infected listed by regions"
    echo " "
    echo "Filters:"
    echo "Can be combination of several filters listed below, each can be used only once."
    echo "  -a DATETIME     -consider only entries after DATETIME"
    echo "  -b DATETIME     -consider only entries before DATETIME"
    echo "  -g GENDER       -consider only entries with given gender(M/Z)"
    echo "  -s [WIDTH]      -shows data in histograms"
    echo "                  Works for: gender, age, daily, monthly, yearly, " 
    echo "                             countries, districts and regions."
    echo "                  [WIDTH] sets max width of histograms"

}

filter_argument_check()
{
    case $2 in
        *.csv)
            >&2 echo "Missing filter argument"
            exit 1
            ;;
        *.gz)
            >&2 echo "Missing filter argument"
            exit 1
            ;;
        *.bz2)
            >&2 echo "Missing filter argument"
            exit 1
            ;;
    esac
    if  [ "$2" = "merge" ] || [ "$2" = "infected" ] || [ "$2" = "gender" ] || [ "$2" = "age" ] || [ "$2" = "daily" ] ||
        [ "$2" = "monthly" ] || [ "$2" = "yearly" ] || [ "$2" = "countries" ] || [ "$2" = "districts" ] || [ "$2" = "regions" ]
    then
        >&2 echo "Missing filter argument"
        exit 1
    fi
}

COMMAND=""
GRAPH=""
DATETIME=""
DATETIME_INFO=""
WIDTH=""
FILE="cat "

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h)
            print_help
            exit 0
            ;;
        -a | -b)
            filter_argument_check "$@"
            DATETIME_INFO=$1
            DATETIME=$2
            shift
            shift
            ;;
        -g)
            filter_argument_check "$@"
            GENDER=$2
            shift
            shift
            ;;
        -s)
            GRAPH="1"
            if [ -n "${2##*[!0-9]*}" ]
            then
                WIDTH=$2
                shift
            fi
            shift
            ;;
        infected | gender | age | daily | monthly | yearly | countries | districts | regions)
            COMMAND=$1
            shift
            ;;
        *.gz)
            if [ "$FILE" !=  "cat " ]; then
                FILE="$FILE $1"
            else
                FILE="gzip -d -c $1"
            fi
            shift
            ;;
        *.bz2)
            if [ "$FILE" != "cat " ]; then
                FILE="$FILE $1"
            else
                FILE="bzip2 -d -c $1"
            fi
            shift
            ;;
        *.csv)
            if [ "$1" = "infected-jan22/infected-22-01-*.csv" ]; then
                exit 0
            fi

            if [ "$FILE" != "cat " ]; then
                FILE="$FILE $1"
            else
                FILE="cat $1"
            fi
            shift
            ;;
        merge)
            ;;
        *)
            FILE="cat "
            ;;
    esac
done


#managing filters
FILTER1=""
if [ "$DATETIME" ]; then
    if [ "$DATETIME_INFO" = "-a" ]; then
        FILTER1="awk -vDATETIME=\"$DATETIME\" -F, '{if(NR == 1) {print \$0} else {if(DATETIME <= \$2) print \$0}}'"
    fi
    if [ "$DATETIME_INFO" = "-b" ]; then
        FILTER1="awk -vDATETIME=\"$DATETIME\" -F, '{if(NR == 1) {print \$0} else {if(DATETIME >= \$2) print \$0}}'"
    fi
fi

FILTER2=""
if [ "$GENDER" ]; then
    FILTER2="awk -F, -vGENDER=\"$GENDER\" '{if(NR == 1) {print \$0} 
                                            else {if(\$4 == GENDER) print \$0}}'"
fi

FILTER="cat "
if [ "$FILTER1" ] && [ "$FILTER2" ]; then
    FILTER=$FILTER1" | "$FILTER2
else
    if [ "$FILTER1" ]; then
    FILTER=$FILTER1
    fi
    if [ "$FILTER2" ]; then
    FILTER=$FILTER2
    fi
fi

if [ "$COMMAND" = "" ]; then
    COMMAND="merge"
fi

#data validity check
DATE_CHECK="awk -F ',' 'split(\$2, a, \"-\") {if(NR == 1) {print \$0; next}
                    else if (\$2 == \"\")
                    {
                        print \$0
                        next
                    }
                    else if (\$2 ~ /[.]/ || \$2 ~ /[e]/)
                    {
                        print \"Invalid date: \"\$0 > \"/dev/stderr\"
                        next
                    }
                    else if(a[2] == \"01\")
                    {
                        if(a[3] > \"31\")
                        {
                            print \"Invalid date: \"\$0 > \"/dev/stderr\"
                            next
                        }
                    }
                    else if(a[2] == \"02\")
                    {
                        if(a[1] % 400 == 0 || (a[1] % 4 == 0 && a[1] % 100 != 0))
                        {
                            if(a[3] > \"29\")
                            {
                                print \"Invalid date: )\$0\" > \"/dev/stderr\"
                                next
                            }
                        }
                        else if(a[3] > \"28\")
                        {
                            print \"Invalid date: \"\$0 > \"/dev/stderr\"
                            next
                        }
                    }
                    else if(a[2] == \"03\" || a[2] == \"05\" || a[2] == \"07\" ||
                            a[2] == \"08\" || a[2] == \"10\" || a[2] == \"12\")
                    {
                        if(a[3] > \"31\")
                        {
                            print \"Invalid date: \"\$0 > \"/dev/stderr\"
                            next
                        }
                    }
                    else if(a[2] == \"04\" || a[2] == \"06\" || a[2] == \"09\" ||
                            a[2] == \"11\")
                    {
                        if(a[3] > \"30\")
                        {
                            print \"Invalid date: \"\$0 > \"/dev/stderr\"
                            next
                        }
                    }
                    else if(a[2] < \"01\" || a[2] > \"12\" || a[3] < \"01\")
                    {
                        print \"Invalid date: \"\$0 > \"/dev/stderr\"
                        next
                    }
                print \$0 }' "

# age vailidty check
AGE_CHECK="awk -F ',' 'age=\"\$3\" {if(NR == 1)
                    {
                        print \$0
                        next
                    }
                    else if (age ~ /[.]/ || age ~ /[e]/)
                    {
                        print \"Invalid age: \"\$0 > \"/dev/stderr\"
                        next
                    }
                    else if(age > 0)
                    {
                        print \"Invalid age: \"\$0 > \"/dev/stderr\"
                        next
                    }
                    print \$0} '"
if [ "$COMMAND" != "merge" ]; then
    FILE=$FILE" | "$DATE_CHECK
    FILE=$FILE" | "$AGE_CHECK
fi

#commands
case "$COMMAND" in
    merge)
        eval "$FILE | $FILTER | awk '!x[\$0]++'"
        ;;
    infected)
        eval "$FILE | $FILTER" | awk -F, -vFILTER="$FILTER" 'BEGIN{if(FILTER == "cat ") c--}
        {c++} END{printf("%d\n", c)}'
        ;;
    gender)
        eval "$FILE | $FILTER" | awk -F ',' -vGRAPH="$GRAPH" -vWIDTH="$WIDTH" 'gender=$4 {if(gender == "pohlavi") next}
                            {if(gender == "M") m++}
                            {if(gender == "Z") z++}
                            {if(gender == "") none++}
                END {if(GRAPH == "")
                {
                    printf("M: %d\nZ: %d\n", m, z)
                    if(none != 0) printf("None: %d\n", none)
                }
                else 
                {   
                    if(WIDTH == "")
                    {
                        rate = 100000
                    }
                    else
                    {
                        if(m > z)
