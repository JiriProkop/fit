        eval "$FILE | $FILTER" | awk -F ',' -vGRAPH="$GRAPH" -vWIDTH="$WIDTH" 'age=$3 {if(NR == "vek") next}
                           {if(age >= 0 && age <=  5) c[0]++}
                           {if(age >  5 && age <= 15) c[1]++}
                           {if(age > 15 && age <= 25) c[2]++}
                           {if(age > 25 && age <= 35) c[3]++}
                           {if(age > 35 && age <= 45) c[4]++}
                           {if(age > 45 && age <= 55) c[5]++}
                           {if(age > 55 && age <= 65) c[6]++}
                           {if(age > 65 && age <= 75) c[7]++}
                           {if(age > 75 && age <= 85) c[8]++}
                           {if(age > 85 && age <= 95) c[9]++}
                           {if(age > 95 && age <= 105)c[10]++}
                           {if(age > 105             )c[11]++}
                           {if(age==""              )none++}
