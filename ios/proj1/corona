                else
                {
                    prev_cntr=cntr
                    c++
                    flag=1
                }
            }
        }
        END {if(GRAPH == "")
            {
                if(c != 0) printf("%s: %d\n", prev_cntr, c)
            }
            else
            {
                if(c != 0)
                {
                    printf("%s: ", prev_cntr)
                    for(i = 0; i < c / WIDTH - 1; i++)
                    {
                        printf("#")
                    }
                    printf("\n")
                }
            }
        }'
        ;;
    districts)
        eval "$FILE | $FILTER" | sort -t ',' -k 6 | awk -F ',' -vGRAPH="$GRAPH" -vWIDTH="$WIDTH" 'distr=" ", distr=$6 {
            if(distr == "okres_lau_kod")
                next
            if(WIDTH == "")
            {
                WIDTH = 1000
            }
            else
            {
                GRAPH=""
            }
            if(distr=="")
            {
                none++
                next
            }
            if(flag)
            {
                if(distr==prev_distr)
                    c++
                else
                {
                    if(GRAPH == "")
                    {
                        printf("%s: %d\n", prev_distr, c)
                    }
                    else
                    {
                        printf("%s: ", prev_distr)
                        for(i = 0; i < c / WIDTH - 1; i++)
                        {
                            printf("#")
                        }
                        printf("\n")
                    }

                    c=1
                    prev_distr=distr
                }
            }
            else
            {
                prev_distr=distr
                c++
                flag=1
            }
        }
        END {if(GRAPH == "")
            {
                if(c != 0) 
                {
                    printf("%s: %d\n", prev_distr, c)
                }
                if(none != 0)
                {
                    printf("None: %d\n", none)
                }
            }
            else
            {
                if(c != 0)
                {
                    printf("%s: ", prev_distr)
                    for(i = 0; i < c / WIDTH - 1; i++)
                    {
                        printf("#")
                    }
                    printf("\n")
                }
                if(none != 0)
                {
                    printf("None: ")
                    for(i = 0; i < none / WIDTH - 1; i++)
                    {
                        printf("#")
                    }
                    printf("\n")
                }
            }
        }'
        ;;
    regions)
        eval "$FILE | $FILTER" | sort -t ',' -k 5 | awk -F ',' -vGRAPH="$GRAPH" -vWIDTH="$WIDTH" 're=" ", reg=$5 {
            if(reg == "kraj_nuts_kod")
                next
            if(WIDTH == "")
            {
                WIDTH = 10000
            }
            else
            {
                GRAPH=""
            }
            if(reg=="")
            {
                none++
                next
            }
            if(flag)
            {
                if(reg==prev_reg)
                    c++
                else
                {
                    if(GRAPH == "")
                    {
                        printf("%s: %d\n", prev_reg, c)
                    }
                    else
                    {
                        printf("%s: ", prev_reg)
                        for(i = 0; i < c / WIDTH - 1; i++)
                        {
                            printf("#")
                        }
                        printf("\n")
                    }

                    c=1
                    prev_reg=reg
                }
            }
            else
            {
                prev_reg=reg
                c++
                flag=1
            }
        }
        END {if(GRAPH == "")
            {
                if(c != 0) 
                {
                    printf("%s: %d\n", prev_reg, c)
                }
                if(none != 0)
                {
                    printf("None: %d\n", none)
                }
            }
            else
            {
                if(c != 0)
                {
                    printf("%s: ", prev_reg)
                    for(i = 0; i < c / WIDTH - 1; i++)
                    {
                        printf("#")
                    }
                    printf("\n")
                }
                if(none != 0)
                {
                    printf("None: ")
                    for(i = 0; i < none / WIDTH - 1; i++)
                    {
                        printf("#")
                    }
                    printf("\n")
                }
            }
        }'
        ;;
esac