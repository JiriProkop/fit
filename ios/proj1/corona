                        printf("%s: %d\n", prev_date, c)
                        
                    }
                    else
                    {
                        
                        printf("%s: ", prev_date)
                        for(i = 0; i < c / WIDTH - 1; i++)
                        {
                            printf("#")
                        }
                        printf("\n")
                    }
                
                    c=1
                    prev_date=date
                }
            }
            else
            {
                
                prev_date=date
                c++
                flag=1
            }
        }
        END {if(GRAPH == "")
        {
            if(c != 0) printf("%s: %d\n", prev_date, c)
            if(none != 0) printf("None: %d\n", none) 
        }
        else
        {
            if(c != 0)
            {
                printf("%s: ", prev_date)
                for(i = 0; i < c / WIDTH - 1; i++)
                {
                    printf("#")
                }
                printf("\n")
            }
            if(none != 0)
            {
                printf("None: ")
                for(i = 0; i < none / WIDTH - 1; i++)
                {
                    printf("#")
                }
                printf("\n")
            }
        }}'  
        ;;
    yearly)
        eval "$FILE | $FILTER" | sort -t ',' -k 2 | awk -F ',' -vGRAPH="$GRAPH" -vWIDTH="$WIDTH" 'date=" ", date=$2 {
            if(WIDTH == "")
            {
                WIDTH = 100000
            }
            else
            {
                GRAPH=""
            }
            if(date == "datum")
                next
            if(date=="")
            {
                none++
                next
            }
            else
            {
                split(date, a, "-")
                date=a[1]
            }
            if(flag)
            {
                if(date==prev_date)
                    c++
                else
                {
                    if(GRAPH == "")
                    {
                        printf("%s: %d\n", prev_date, c)
                    }
                    else
                    {
                        printf("%s: ", prev_date)
                        for(i = 0; i < c / WIDTH - 1; i++)
                        {
                            printf("#")
                        }
                        printf("\n")
                    }
                
                    c=1
                    prev_date=date
                }
            }
            else
            {
                prev_date=date
                c++
                flag=1
            }
        }
        END {if(GRAPH == "")
            {
                if(c != 0) printf("%s: %d\n", prev_date, c)
                if(none != 0) printf("None: %d\n", none) 
            }
            else
            {
                if(c != 0)
                {
                    printf("%s: ", prev_date)
                    for(i = 0; i < c / WIDTH - 1; i++)
                    {
                        printf("#")
                    }
                    printf("\n")
                }
                if(none != 0)
                {
                    printf("None: ")
                    for(i = 0; i < none / WIDTH - 1; i++)
                    {
                        printf("#")
                    }
                    printf("\n")
                }
            }
        }'
        ;;
    countries)
        eval "$FILE | $FILTER" | sort -t ',' -k 8 | awk -F ',' -vGRAPH="$GRAPH" -vWIDTH="$WIDTH" 'cntr=$8 {
            if(cntr == "nakaza_zeme_csu_kod")
                next
            if(WIDTH == "")
            {
