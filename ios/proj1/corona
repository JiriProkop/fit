                        printf("#")
                    }
                    
                    printf("\n16-25 : ")
                    for(i = 0; i < c[2] / rate - 1; i++)
                    {
                        printf("#")
                    }

                    printf("\n26-35 : ")
                    for(i = 0; i < c[3] / rate - 1; i++)
                    {
                        printf("#")
                    }

                    printf("\n36-45 : ")
                    for(i = 0; i < c[4] / rate - 1; i++)
                    {
                        printf("#")
                    }

                    printf("\n46-55 : ")
                    for(i = 0; i < c[5] / rate - 1; i++)
                    {
                        printf("#")
                    }

                    printf("\n56-65 : ")
                    for(i = 0; i < c[6] / rate - 1; i++)
                    {
                        printf("#")
                    }

                    printf("\n66-75 : ")
                    for(i = 0; i < c[7] / rate - 1; i++)
                    {
                        printf("#")
                    }

                    printf("\n76-85 : ")
                    for(i = 0; i < c[8] / rate - 1; i++)
                    {
                        printf("#")
                    }

                    printf("\n86-95 : ")
                    for(i = 0; i < c[9] / rate - 1; i++)
                    {
                        printf("#")
                    }

                    printf("\n96-105: ")
                    for(i = 0; i < c[10] / rate - 1; i++)
                    {
                        printf("#")
                    }

                    printf("\n>105  : ")
                    for(i = 0; i < c[11] / rate - 1; i++)
                    {
                        printf("#")
                    }

                    printf("\n")
                    if(none > 0)
                    {
                        printf("None  : ")
                        for(i = 0; i < none / rate - 1; i++)
                        {
                            printf("#")
                        }
                        printf("\n")
                    }
                }}'
        ;;
    daily)
        eval "$FILE | $FILTER" | sort -t ',' -k 2 | awk -F ',' -vGRAPH="$GRAPH" -vWIDTH="$WIDTH" 'date=" ", date=$2 {if(date == "datum") next
            if(WIDTH == "")
            {
                WIDTH = 500
            }
            if(flag)
            {
                if(date==prev_date)
                {
                    c++
                }
                else
                {
                    if(GRAPH == "")
                    {
                        printf("%s: %d\n", prev_date, c)
                    }
                    else
                    {
                        printf("%s: ", prev_date)
                        for(i = 0; i < c / WIDTH - 1; i++)
                        {
                            printf("#")
                        }
                        printf("\n")
                    }
                
                    c=1
                    prev_date=date
                }
            }
            else
            {
                if(date=="")
                {
                    none++
                    next
                }
                prev_date=date
                c++
                flag=1
            }
        }
        END {if(GRAPH == "")
        {
            if(c != 0) printf("%s: %d\n", prev_date, c)
            if(none != 0) printf("None: %d\n", none) 
        }
        else
        {
            if(c != 0)
            {
                printf("%s: ", prev_date)
                for(i = 0; i < c / WIDTH - 1; i++)
                {
                    printf("#")
                }
                printf("\n")
            }
            if(none != 0)
            {
                printf("None: ")
                for(i = 0; i < none / WIDTH - 1; i++)
                {
                    printf("#")
                }
                printf("\n")
            }
        }}'   
        ;;
    monthly)
        eval "$FILE | $FILTER" | sort -t ',' -k 2 | awk -F ',' -vGRAPH="$GRAPH" -vWIDTH="$WIDTH" 'date=" ", date=$2 {
            if(date == "datum")
